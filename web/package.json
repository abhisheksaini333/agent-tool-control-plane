{
  "name": "keel-control-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "start": "node server.mjs",
    "test:browser": "playwright test",
    "test": "node --test test/*.test.mjs",
    "format": "prettier --write src test e2e build.mjs server.mjs playwright.config.ts",
    "format:check": "prettier --check src test e2e build.mjs server.mjs playwright.config.ts"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.31.2",
    "@types/node": "18.15.3",
    "@types/prop-types": "15.7.5",
    "@types/react": "18.0.28",
    "@types/react-dom": "18.0.11",
    "@types/scheduler": "0.16.2",
    "csstype": "3.1.1",
    "esbuild": "0.17.14",
    "prettier": "2.8.8",
    "typescript": "4.9.5"
  },
  "overrides": {
    "@types/prop-types": "15.7.5",
    "@types/scheduler": "0.16.2",
    "csstype": "3.1.1",
    "fsevents": "2.3.2",
    "@types/node": "18.15.3",
    "scheduler": "0.23.0"
  }
}
